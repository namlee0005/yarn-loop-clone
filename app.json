{
  "expo": {
    "name": "Yarn Loop",
    "slug": "yarn-loop",
    "version": "1.0.0",
    "scheme": "yarnloop",
    "sdkVersion": "51.0.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "expo-router",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "yarn-loop",
          "organization": "your-org"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}